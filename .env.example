# ===== قاعدة البيانات =====
DATABASE_URL=postgres://abusamir:abusamir_dev@localhost:5432/abusamir
TEST_DATABASE_URL=postgres://abusamir:abusamir_dev@localhost:5432/abusamir_test

# ===== الخادم =====
PORT=4000
NODE_ENV=development
# مفتاح توقيع الجلسات - غيّره في الإنتاج (32 حرفًا على الأقل)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
SESSION_HOURS=12
# عند التشغيل خلف HTTPS اجعلها true
COOKIE_SECURE=false
CLIENT_ORIGIN=http://localhost:5173

# ===== التخزين =====
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25
# مفتاح تشفير الملفات المخزّنة (hex 64 حرفًا = 32 بايت). اتركه فارغًا لتعطيل التشفير أثناء التطوير.
FILE_ENCRYPTION_KEY=

# ===== الذكاء الاصطناعي (اختياري) =====
# none | anthropic
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# يجب تفعيل الإرسال صراحةً قبل إرسال أي بيانات عميل لمزوّد خارجي
AI_ALLOW_EXTERNAL=false

# ===== PDF =====
# مسار Chromium (اختياري). يُترك فارغًا لاستخدام متصفح Playwright المثبّت
CHROMIUM_PATH=

# ===== المستخدم الأول (يُنشأ عند seed فقط إن لم يوجد مستخدمون) =====
ADMIN_EMAIL=admin@office.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=مدير النظام
