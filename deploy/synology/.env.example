# ===== انسخ هذا الملف إلى .env بجانب docker-compose.yml وعدّل القيم =====
# كلمة مرور قاعدة البيانات (اختر قيمة قوية؛ لا تُشارك)
DB_PASSWORD=
# المنفذ الذي يظهر عليه التطبيق على الـ NAS (ثم تربطه بـ Reverse Proxy في DSM)
APP_PORT=4050
# مفتاح توقيع الجلسات: 32 حرفًا على الأقل (مثال: openssl rand -hex 32)
JWT_SECRET=
# مفتاح تشفير الملفات المرفوعة (hex 64 حرفًا = openssl rand -hex 32). اتركه فارغًا لتعطيل التشفير
FILE_ENCRYPTION_KEY=
# عنوان الواجهة كما يفتحه المستخدمون عبر Reverse Proxy (مثال: https://sahm5.synology.me:4443 أو https://accounting.sahm5.synology.me)
CLIENT_ORIGIN=https://sahm5.synology.me
# true عند الوصول عبر HTTPS فقط (موصى به مع Reverse Proxy في DSM)
COOKIE_SECURE=true
SESSION_HOURS=12
MAX_UPLOAD_MB=25
# المستخدم الأول (يُنشأ مرة واحدة فقط إن لم يوجد مستخدمون، ويُجبر على تغيير كلمة المرور عند أول دخول)
ADMIN_EMAIL=admin@office.local
ADMIN_PASSWORD=
ADMIN_NAME=مدير النظام
# الذكاء الاصطناعي (اختياري) - اتركه none حتى يتم التفويض
AI_PROVIDER=none
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_ALLOW_EXTERNAL=false
